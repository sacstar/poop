<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PstSplitter</AssemblyName>
    <RootNamespace>PstSplitter</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>PST Splitter</Product>
    <AssemblyTitle>PST Splitter</AssemblyTitle>
    <Description>Splits a large Outlook PST file into smaller PST files.</Description>
    <Version>1.0.0</Version>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
</Project>
